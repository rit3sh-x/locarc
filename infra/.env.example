# GitHub repository (owner/repo)
GITHUB_REPO="your-github-org/your-repo"

# GCP project ID (from https://console.cloud.google.com)
GCP_PROJECT_ID="your-gcp-project-id"

# GCP region for Cloud Run (pick one close to your Convex deployment)
GCP_REGION="europe-west1"

# Cloudflare API token (from https://dash.cloudflare.com/profile/api-tokens)
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"

# Cloudflare account ID (from dashboard sidebar)
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"

# Cloudflare Pages project name
CLOUDFLARE_PROJECT_NAME="your-project-name"

# Convex production deploy key (from Convex Dashboard > Settings > Deploy Key)
CONVEX_DEPLOY_KEY="your-convex-deploy-key"

# Convex deployment slug (e.g. "calm-horse-123" — URLs are derived automatically)
CONVEX_DEPLOYMENT="your-deployment-slug"

# Shared HMAC secret between Convex and Server (leave empty to auto-generate)
WEBHOOK_SECRET=""

# Localization algorithm: "annulus" or "circle"
LOCALIZATION_ALGO="annulus"

# RF path loss exponent
PATH_LOSS_EXPONENT="3.5"

# Min/max transmission power in dBm
PT_MIN_DBM="20.0"
PT_MAX_DBM="43.0"
