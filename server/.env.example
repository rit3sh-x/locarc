# Webhook secret used for verifying incoming requests
WEBHOOK_SECRET=example_webhook_secret

# Localization algorithm to use: "annulus" or "circle"
LOCALIZATION_ALGO=annulus

# Path loss exponent for localization calculations
PATH_LOSS_EXPONENT=3.5

# Minimum and maximum transmission power in dBm
PT_MIN_DBM=20.0
PT_MAX_DBM=43.0

# Server host and port
HOST=0.0.0.0
PORT=8000