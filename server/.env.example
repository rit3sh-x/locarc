# Webhook secret — shared between Convex and this server for request auth
WEBHOOK_SECRET=example_webhook_secret

# Convex site URL — only requests with callback URLs to this origin are accepted
CONVEX_SITE_URL=https://your-deployment.region.convex.site

# Localization algorithm to use: "annulus" or "circle"
LOCALIZATION_ALGO=annulus

# Path loss exponent for localization calculations
PATH_LOSS_EXPONENT=3.5

# Minimum and maximum transmission power in dBm
PT_MIN_DBM=20.0
PT_MAX_DBM=43.0

# GCP deployment
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
