# Copy to .env.local, the project's one env file (git ignores it): `cp .env.example .env.local`.
# Bun, Vite and Convex all read it; only VITE_* values reach the website.

# Your Organization and first Operator, used by `bun run setup`.
LOCARC_ORG_NAME="My Organization"
LOCARC_OPERATOR_NAME="First Operator"
LOCARC_OPERATOR_EMAIL="operator@example.com"
LOCARC_OPERATOR_PASSWORD="change-me-please"
# The website origin the deployment serves; defaults to the Vite dev server.
# Required with `bun run setup --prod`: the production website's origin.
# LOCARC_SITE_URL="https://locarc.example.com"

# Added for you, don't copy them from here:
# - Convex writes CONVEX_DEPLOYMENT, VITE_CONVEX_URL and VITE_CONVEX_SITE_URL.
# - `bun run setup` saves the dev deployment's secrets: BETTER_AUTH_SECRET (website sign-in),
#   RECEIVER_JWT_PRIVATE_KEY and RECEIVER_JWT_PUBLIC_JWK (phone tokens), VAPID_PUBLIC_KEY and
#   VAPID_PRIVATE_KEY (browser push). Edit one and rerun setup to change it on the deployment.
#   Production's are generated on production and never stored here.

# Only for a signed release build on this machine (`bun run build:android release`); CI keeps
# these as GitHub secrets.
# LOCARC_KEYSTORE_FILE="/path/to/upload.jks"
# LOCARC_KEYSTORE_PASSWORD=""
# LOCARC_KEY_ALIAS="upload"
# LOCARC_KEY_PASSWORD=""
